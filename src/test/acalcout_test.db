
record(acalcout, "$(P=TestLoad):WAVECreate") {
    field(INPA, "2.5")
    field(NELM, "$(SIZE=2)")
    field(CALC, "((IX+1)/(IX+1))*A")
    field(OUT,  "$(P=TestLoad):WAVE PP")
    field(PINI, "YES")
}

record(waveform, "$(P=TestLoad):WAVE"){
    field(NELM, "$(SIZE=2)")
    field(FTVL, "DOUBLE")
}
