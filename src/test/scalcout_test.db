record(scalcout, "$(P=TestLoad):SetTest") {
    field(DESC, "Create Test Str")
    field(CALC, "AA+printf(' %.3f',A)")
    field(OUT,  "$(P=TestLoad):WritedTest PP MS")
    field(AA,   "TEST")
    field(A,     1.2345)
    field(PINI, "YES")
}

record(stringin, "$(P=TestLoad):WritedTest") {
    field(DESC, "Holds output scalcout string")
}
